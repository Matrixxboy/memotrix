# Copy to .env and fill in. Nothing is defaulted by the library.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MEMOTRIX_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/memotrix

# Docker Compose (memory/docker-compose.yml) — required, no defaults:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=memotrix

# Optional
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# MEMOTRIX_TABLE=memotrix_chunks
# OPENAI_API_KEY=
# OPENAI_MODEL=
